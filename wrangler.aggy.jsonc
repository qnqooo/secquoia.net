{
  "name": "secquoia-aggy-realtime",
  "main": "workers/aggy-realtime-session.js",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "aggy.secquoia.group",
      "custom_domain": true
    }
  ],
  "vars": {
    "OPENAI_REALTIME_MODEL": "gpt-realtime-2.1",
    "AGGY_GLASSWALL_MODE": "QUHUB_CDR_CONFIGURED_FAIL_CLOSED",
    "AGGY_QUHUB_CDR_URL": "https://quhub.secquoia.group/v1/cdr/sanitize",
    "AGGY_PREVIEW_POLICY_EPOCH": "2026-07-27.1"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AGGY_CHAT_ROOMS",
        "class_name": "AggyChatRoom"
      },
      {
        "name": "AGGY_USAGE_METERS",
        "class_name": "AggyUsageMeter"
      },
      {
        "name": "AGGY_QUVAULT_FILES",
        "class_name": "AggyVault"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-aggy-secure-chat",
      "new_sqlite_classes": [
        "AggyChatRoom"
      ]
    },
    {
      "tag": "v2-aggy-usage-meter",
      "new_sqlite_classes": [
        "AggyUsageMeter"
      ]
    },
    {
      "tag": "v3-aggy-quvault-files",
      "new_sqlite_classes": [
        "AggyVault"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
