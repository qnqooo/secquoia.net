{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqaile.dev/schemas/platform-manifest-1.0.0.json",
  "type": "object",
  "required": ["schemaVersion", "platform", "domain", "classification", "controlPlane", "edge", "identity", "platformBff", "integrationGateway", "engineApi", "providerAccess", "security", "audit", "secrets", "failClosed", "productionEvidenceRequired", "rollback"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "platform": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 3},
    "classification": {"enum": ["corporate-public", "product-public", "private-application"]},
    "controlPlane": {"const": "SQAILE"},
    "edge": {"const": "Cloudflare"},
    "identity": {"const": "QuIdentify"},
    "platformBff": {"const": "required"},
    "integrationGateway": {"const": "QuHub"},
    "engineApi": {"const": "private"},
    "providerAccess": {"const": "connector-only"},
    "security": {"type": "array", "contains": {"const": "QuFense"}, "minItems": 2},
    "audit": {"const": "QuAudit"},
    "operations": {"type": "array", "minItems": 1},
    "secrets": {"type": "string", "pattern": "QuVault"},
    "failClosed": {"const": true},
    "productionEvidenceRequired": {"const": true},
    "rollback": {"type": "string", "minLength": 10}
  },
  "additionalProperties": false
}
